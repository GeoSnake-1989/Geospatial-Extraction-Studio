# Store portable text files with LF in Git while retaining Windows-native
# line endings for command and PowerShell scripts.
* text=auto
*.tsx text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Evidence files are immutable byte-for-byte snapshots whose recorded hashes
# must not be changed by text normalization.
packaging/native-evidence/** -text whitespace=-trailing-space,-blank-at-eof
# Upstream source archives and pinned recipe archives are also immutable binary
# evidence; Git must not rewrite their bytes because their digests are verified.
packaging/native-source/** -text
packaging/native-source/README.md text eol=lf
packaging/python-source/** -text
packaging/python-source/README.md text eol=lf

# Keep local environments, generated output, and excluded research out of
# source archives even if a file is accidentally tracked in the future.
backend/.venv/ export-ignore
.pnpm-store/ export-ignore
frontend/node_modules/ export-ignore
frontend/.pnpm-store/ export-ignore
frontend/.pnpm-cache/ export-ignore
frontend/dist/ export-ignore
data/app.db export-ignore
data/original/ export-ignore
data/processed/ export-ignore
data/cache/ export-ignore
data/logs/ export-ignore
data/exports/ export-ignore
tmp/ export-ignore
*.pdf export-ignore

build/ export-ignore
