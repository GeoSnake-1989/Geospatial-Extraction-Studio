# Custom tile providers must be configured with all three values.
# The application appends a permanent OpenStreetMap data/search credit.
# This value must contain the custom tile provider's own required attribution.
VITE_OSM_TILE_URL=
VITE_OSM_TILE_ATTRIBUTION=
# Link directly to the provider's controlling license or usage terms.
VITE_OSM_TILE_LICENSE_URL=
